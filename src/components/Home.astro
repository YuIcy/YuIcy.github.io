---
import { getCollection } from 'astro:content';
import profile from '../data/profile.json';
import '../styles/global.css';

interface Props { locale: 'en' | 'zh' }
const { locale } = Astro.props;
const zh = locale === 'zh';
const t = (en: string, cn: string) => zh ? cn : en;
const projects = (await getCollection('projects')).sort((a,b) => a.data.order-b.data.order);
const featured = projects.filter(p => p.data.featured);
const other = projects.filter(p => !p.data.featured);
const canonical = new URL(zh ? '/zh/' : '/', Astro.site);
const title = t('Xin Hao — Visualization & Digital Humanities', '郝昕 — 可视化与数字人文');
const description = profile.bio[locale];
---
<!doctype html>
<html lang={zh ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8f5ed" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={new URL('/', Astro.site)} />
    <link rel="alternate" hreflang="zh-CN" href={new URL('/zh/', Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/social-card.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={zh ? 'zh_CN' : 'en_US'} />
  </head>
  <body>
    <a class="skip-link" href="#main">{t('Skip to content', '跳转到正文')}</a>
    <header class="site-header wrap">
      <a class="wordmark" href={zh ? '/zh/' : '/'} aria-label={t('Xin Hao, home', '郝昕，首页')}>Xin Hao</a>
      <nav class="desktop-nav" aria-label={t('Main navigation', '主导航')}>
        <a href="#about">{t('About', '关于')}</a><a href="#work">{t('Projects', '项目')}</a><a href="#background">{t('Education', '教育')}</a><a href="#contact">{t('Contact', '联系')}</a>
      </nav>
      <div class="header-actions">
        <a class="language-link" href={zh ? '/' : '/zh/'} lang={zh ? 'en' : 'zh-CN'} aria-label={t('切换到中文', 'Switch to English')}>{t('中文', 'EN')}</a>
        <details class="mobile-nav">
          <summary aria-label={t('Navigation menu', '导航菜单')}><span></span><span></span></summary>
          <nav aria-label={t('Mobile navigation', '移动端导航')}><a href="#about">{t('About', '关于')}</a><a href="#work">{t('Projects', '项目')}</a><a href="#background">{t('Education', '教育')}</a><a href="#contact">{t('Contact', '联系')}</a></nav>
        </details>
      </div>
    </header>

    <main id="main">
      <section id="about" class="hero wrap" aria-labelledby="hero-title">
        <div class="identity">
          <h1 id="hero-title">{profile.name[locale]}<span class="name-secondary">{zh ? 'Xin Hao' : '郝昕'}</span></h1>
          <p class="affiliation">{profile.affiliation[locale]}</p>
        </div>
        <img class="portrait" src="/images/xin-hao.jpg" width="780" height="1080" alt={t('Portrait of Xin Hao', '郝昕的个人照片')} fetchpriority="high" />
        <div class="hero-text">
          <p>{profile.bio[locale]}</p>
          <p>{profile.research[locale]}</p>
          <div class="profile-links">
            <a href={'mailto:' + profile.email}>{profile.email}</a>
            <a href={profile.github}>GitHub</a>
          </div>
        </div>
      </section>

      <section id="work" class="section wrap" aria-labelledby="work-title">
        <h2 id="work-title">{t('Selected projects', '研究与项目')}</h2>
        <div class="projects">
          {featured.map(({id, data: p}) => (
            <article class="project" id={'project-' + id}>
              <div class="project-heading">
                <h3>{p.title[locale]}</h3>
                <p class="project-meta">{p.period} · {p.category[locale]}</p>
              </div>
              <div class="project-description">
                {p.screenshot && <figure class="project-screenshot">
                  <a href={p.screenshot.src} aria-label={t('View full screenshot: ', '查看完整截图：') + p.title[locale]}><img src={p.screenshot.src} width={p.screenshot.width} height={p.screenshot.height} alt={p.screenshot.alt[locale]} loading="lazy" decoding="async" /></a>
                  <figcaption>{p.screenshot.source ? <a href={p.screenshot.source}>{p.screenshot.caption[locale]}</a> : p.screenshot.caption[locale]}</figcaption>
                </figure>}
                <p>{p.summary[locale]}</p>
                {p.role && <p class="project-role"><strong>{t('My contribution: ', '个人贡献：')}</strong>{p.role[locale]}</p>}
                {p.note && <p class="project-note">{p.note[locale]}</p>}
                {p.code && <a class="code-link" href={p.code}>{t('Source code on GitHub', 'GitHub 源码')}</a>}
              </div>
            </article>
          ))}
        </div>
        <h3 class="other-heading">{t('Other projects', '其他项目')}</h3>
        <div class="other-projects">
          {other.map(({data: p}) => (
            <article class="other-project">
              <span class="other-period">{p.period}</span>
              <div>
                <h4>{p.code ? <a href={p.code}>{p.title[locale]}</a> : p.title[locale]}</h4>
                {p.screenshot && <figure class="project-screenshot">
                  <a href={p.screenshot.src} aria-label={t('View full screenshot: ', '查看完整截图：') + p.title[locale]}><img src={p.screenshot.src} width={p.screenshot.width} height={p.screenshot.height} alt={p.screenshot.alt[locale]} loading="lazy" decoding="async" /></a>
                  <figcaption>{p.screenshot.source ? <a href={p.screenshot.source}>{p.screenshot.caption[locale]}</a> : p.screenshot.caption[locale]}</figcaption>
                </figure>}
                <p>{p.summary[locale]}</p>
                {p.role && <p class="project-role">{p.role[locale]}</p>}
              </div>
            </article>
          ))}
        </div>
      </section>

      <section id="background" class="section wrap" aria-labelledby="background-title">
        <h2 id="background-title">{t('Education', '教育经历')}</h2>
        <div class="education">
          {profile.education.map(item => (
            <article class="education-item">
              <span class="education-period">{item.period}</span>
              <div>
                <h3>{item.institution[locale]}{' '}<span>{item.degree[locale]}</span></h3>
                <p>{item.detail[locale]}</p>
              </div>
            </article>
          ))}
        </div>
        <p class="toolbox"><strong>{t('Tools: ', '常用工具：')}</strong>{profile.skills.join(' · ')}</p>
      </section>

      <section id="contact" class="section contact wrap" aria-labelledby="contact-title">
        <h2 id="contact-title">{t('Contact', '联系方式')}</h2>
        <a href={'mailto:' + profile.email}>{profile.email}</a>
      </section>
    </main>
    <footer class="footer wrap">
      <span>© {new Date().getFullYear()} {profile.name[locale]}</span>
      <a href="#hero-title">{t('Back to top', '回到顶部')}</a>
    </footer>
    <script>
      document.querySelectorAll<HTMLAnchorElement>('.language-link').forEach(link => {
        const base = link.getAttribute('href')!;
        link.addEventListener('click', () => {
          const section = [...document.querySelectorAll<HTMLElement>('main > section[id]')]
            .reverse().find(section => section.getBoundingClientRect().top <= window.innerHeight / 3);
          link.href = base + (section ? '#' + section.id : '');
        });
      });
      document.querySelectorAll<HTMLAnchorElement>('.mobile-nav a').forEach(link => {
        link.addEventListener('click', () => link.closest('details')?.removeAttribute('open'));
      });
      document.addEventListener('keydown', event => {
        if (event.key === 'Escape') {
          const menu = document.querySelector<HTMLDetailsElement>('.mobile-nav[open]');
          menu?.removeAttribute('open');
          menu?.querySelector('summary')?.focus();
        }
      });
    </script>
  </body>
</html>
